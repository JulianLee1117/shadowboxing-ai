{
  "name": "shadowboxing-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mac": "node scripts/start-mac-studio.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json vite.config.ts playwright.config.ts index.html .github/workflows/check.yml model-manifest.json",
    "models:setup": "node scripts/setup-models.mjs",
    "pose:serve": "node scripts/start-local-pose.mjs",
    "check": "npm run format:check && npm run test && npm run test:tools && npm run build",
    "replay": "node scripts/replay-session.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:tools": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "lucide-react": "1.48.0",
    "mediabunny": "1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
